# Copy to .env and fill in. Everything is optional: the offline
# template memo renderer works with zero config and zero network.
# LLM (any OpenAI-compatible chat completions endpoint) — used ONLY to
# reword the decision memo prose. It never makes the decision.
UNDERWRITE_LLM_BASE_URL=http://localhost:11434/v1
UNDERWRITE_LLM_API_KEY=
UNDERWRITE_LLM_MODEL=llama3.1
UNDERWRITE_LLM_TIMEOUT=20
